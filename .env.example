# ==============================================================================
# ORCA — Environment Configuration Template (.env.example)
# Copy this file to `.env` and configure your local/cloud keys
# ==============================================================================

# Server Environment
NODE_ENV=development
PORT=8787
CLIENT_URL=http://127.0.0.1:5173
DATA_MODE=LIVE

# Google Gemini Multimodal AI (Required for AI Console & Regional Voice Assistant)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Database & Telemetry Persistence (Optional - In-memory fallback available)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net
DATABASE_NAME=orca

# Scientific Providers
WEATHER_PROVIDER=open-meteo
MARINE_PROVIDER=open-meteo
LOG_LEVEL=info
RATE_LIMIT=100
CACHE_TTL=600

# Optional Firebase Configuration for Client Authentication
# VITE_FIREBASE_API_KEY=your_firebase_api_key
# VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your_project_id
# VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
# VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
# VITE_FIREBASE_APP_ID=your_app_id
