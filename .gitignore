# ==============================================================================
# ORCA — Git Ignore Configuration
# Protects secrets, credentials, build artifacts, and dependency directories
# ==============================================================================

# Dependencies (Extremely large, always install fresh via `npm install`)
node_modules/
.npm-cache/
.pnp
.pnp.js

# Environment Variables & Secrets (CRITICAL: NEVER UPLOAD TO GITHUB)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
!.env.example

# Production Builds & Compiled Outputs
dist/
dist-ssr/
server/dist/
build/

# TypeScript Incremental Build Caches
*.tsbuildinfo
tsconfig.app.tsbuildinfo
tsconfig.server.tsbuildinfo

# Logs & Temporary Debug Output
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
outputs/
work/

# Operating System & Editor Metadata
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
